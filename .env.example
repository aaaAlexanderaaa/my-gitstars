# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# Public origin the app is reached on. This is baked into the GitHub OAuth callback
# URL, the CORS allow-list and the "secure cookie" decision, so it MUST match the URL
# you actually browse to (no trailing slash, no path).
APP_URL=http://localhost:4000

# Host port to publish. PORT is the port inside the container.
APP_PORT=4000

# Send `Secure` on the session cookie. Auto-detected from APP_URL (https => true);
# set it explicitly if you terminate TLS in front of the app.
# COOKIE_SECURE=true

# Extra origins allowed to call the API with credentials. Only needed when the
# frontend is served from a different origin than the backend. Comma-separated.
# CORS_ORIGINS=https://stars.example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gitstars
# Bundled Postgres container: keep `DB_HOST=db` and run Compose with `--profile local-db`.
# External Postgres: point `DB_HOST`/`DB_PORT` at it and run Compose without the profile.
DB_HOST=db
DB_PORT=5432
# Host port the bundled Postgres is published on (bound to 127.0.0.1 only).
# DB_PUBLISH_PORT=25432
# How long container start-up waits for the database before giving up.
# DB_WAIT_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# GitHub OAuth
# ---------------------------------------------------------------------------
# Create an OAuth app at https://github.com/settings/developers with
#   Homepage URL:               <APP_URL>
#   Authorization callback URL: <APP_URL>/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Signs the session cookie. Generate one with: openssl rand -hex 32
SESSION_SECRET=your_session_secret

# Scopes requested at sign-in. `repo` is only needed to see stars on private
# repositories; narrow it to `read:user,user:email,public_repo` if you don't need that.
# Changing this requires existing users to sign in again.
# GITHUB_OAUTH_SCOPE=read:user,user:email,repo

# ---------------------------------------------------------------------------
# Outbound proxy for reaching GitHub (leave unset for a direct connection)
# ---------------------------------------------------------------------------
# Set when api.github.com is unreachable from your host. Applies to both the Octokit
# client and the axios requests in routes/repos.js. HTTPS_PROXY wins over HTTP_PROXY.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Interval between star sync checks (default: 3600000 = 1 hour)
SYNC_TICK_INTERVAL_MS=3600000
# Interval between version tracking checks (default: 21600000 = 6 hours)
VERSION_TRACKING_TICK_INTERVAL_MS=21600000
# Custom tag that marks a repo for release tracking (default: version-tracking)
VERSION_TRACKING_TAG=version-tracking
# Backoff after a sync failure before retrying (default: 1800000 = 30 minutes)
SYNC_FAILURE_BACKOFF_MS=1800000
# Backoff after an auth failure before retrying (default: 86400000 = 24 hours)
SYNC_AUTH_FAILURE_BACKOFF_MS=86400000
# Delay before the schedulers first run on startup (default: 30000 = 30 seconds)
SCHEDULER_STARTUP_DELAY_MS=30000
# A sync with no progress for this long is treated as dead (default: 1200000 = 20 min)
SYNC_STALE_AFTER_MS=1200000

# ---------------------------------------------------------------------------
# Frontend (build time only)
# ---------------------------------------------------------------------------
# Backend that the `next dev` server proxies /api and /auth to. Unused by the exported
# production build, which the backend serves from the same origin.
# NEXT_PUBLIC_API_URL=http://localhost:4000
